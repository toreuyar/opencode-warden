{
  "name": "opencode-warden",
  "version": "2.2.0",
  "description": "Security plugin for OpenCode — intercepts tool calls to detect secrets, redact sensitive data, evaluate safety risks, block access to sensitive files, and maintain an audit trail",
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./src/index.ts"
    },
    "./rpc": {
      "import": "./dist/rpc.js",
      "types": "./src/rpc.ts"
    },
    "./tui": {
      "import": "./dist/tui.js",
      "types": "./src/tui.ts"
    },
    "./*": {
      "import": "./*",
      "types": "./*"
    }
  },
  "files": [
    "dist",
    "src",
    "opencode-warden.example.json",
    "LICENSE",
    "README.md",
    "warden-icon.svg",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "bun run tsc --noEmit",
    "test": "bun test",
    "build": "bun build src/index.ts src/rpc.ts src/tui.ts --outdir dist --target bun --external sh-ast",
    "prepublishOnly": "bun run build"
  },
  "author": {
    "name": "Töre Çağrı Uyar",
    "url": "https://github.com/toreuyar"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/toreuyar/opencode-warden.git"
  },
  "homepage": "https://github.com/toreuyar/opencode-warden",
  "bugs": {
    "url": "https://github.com/toreuyar/opencode-warden/issues"
  },
  "dependencies": {
    "sh-ast": "0.12.0",
    "zod": "^3.23.0"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.0.18"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.1.4",
    "@types/bun": "^1.1.0",
    "typescript": "^5.5.0"
  },
  "keywords": [
    "opencode",
    "plugin",
    "security",
    "warden",
    "redaction",
    "secrets",
    "audit",
    "safety",
    "llm"
  ],
  "license": "MIT"
}
